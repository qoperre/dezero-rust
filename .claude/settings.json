{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/fmt_on_save.py",
            "timeout": 30,
            "statusMessage": "cargo fmt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_gate.py",
            "timeout": 300,
            "statusMessage": "cargo fmt --check && clippy && test"
          }
        ]
      }
    ]
  }
}
